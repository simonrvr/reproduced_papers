{
  "description": "E10 / paper Prop. 1 and Eq. 144 (no figure): probability of ordering random Haar parameter pairs correctly with N = factor x (Var_samp/Var_circ) shots, for two low-order PNMs and a projector (the projector's ratio grows with the Hilbert dimension); plus the GPSR gradient-variance factor (2R^2+1)/6 on Haar-initialised Clements meshes.",
  "experiment": "sample_complexity",
  "seed": 11,
  "pairs": 2000,
  "epsilon": 0.5,
  "shot_factors": [
    0.1,
    0.3,
    1,
    3,
    10,
    30
  ],
  "cases": [
    {
      "name": "n0^2, M=6, nu=0.5",
      "modes": 6,
      "input": "alternating",
      "observable": {
        "type": "monomial",
        "exponents_by_mode": {
          "0": 2
        }
      }
    },
    {
      "name": "n0 n1, M=8, nu=0.5",
      "modes": 8,
      "input": "alternating",
      "observable": {
        "type": "monomial",
        "exponents_by_mode": {
          "0": 1,
          "1": 1
        }
      }
    },
    {
      "name": "projector |0,1,0,1,0,1,0,1>, M=8",
      "modes": 8,
      "input": "alternating",
      "observable": {
        "type": "projector",
        "pattern": [
          0,
          1,
          0,
          1,
          0,
          1,
          0,
          1
        ]
      }
    }
  ],
  "gradient": {
    "modes": 6,
    "input": "alternating",
    "observable": {
      "type": "monomial",
      "exponents_by_mode": {
        "0": 2
      }
    },
    "inits": 200
  }
}
