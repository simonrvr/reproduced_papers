{
  "description": "E2 (control, not a paper figure): exact Haar moments (Thm. 1, Mhiri et al. Cor. 1 / paper Eq. 12) versus Haar Monte Carlo with Perceval SLOS. Pass rule predeclared: exact identities hold and every |z| < z_threshold.",
  "experiment": "validate_moments",
  "seed": 2026,
  "z_threshold": 4.0,
  "monte_carlo": {"unitaries": 4000, "batch_size": 200, "batches": 20},
  "cases": [
    {"name": "n0^2, M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "monomial", "exponents_by_mode": {"0": 2}}},
    {"name": "n0^2 n1, M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "monomial", "exponents_by_mode": {"0": 2, "1": 1}}},
    {"name": "n0 n1 n2, M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "monomial", "exponents_by_mode": {"0": 1, "1": 1, "2": 1}}},
    {"name": "n0^3, M=8, nu=0.5", "modes": 8, "input": "alternating",
     "observable": {"type": "monomial", "exponents_by_mode": {"0": 3}}},
    {"name": "n0^4, M=4, nu=1", "modes": 4, "input": "all_ones",
     "observable": {"type": "monomial", "exponents_by_mode": {"0": 4}}},
    {"name": "explicit PNP, M=5, input [1,1,0,1,0]", "modes": 5, "input": [1, 1, 0, 1, 0],
     "observable": {"type": "polynomial", "terms": [
       {"exponents_by_mode": {"0": 1}, "coefficient": 0.7},
       {"exponents_by_mode": {"1": 1, "2": 1}, "coefficient": -0.4},
       {"exponents_by_mode": {"3": 2}, "coefficient": 0.3}]}},
    {"name": "random PNP all |alpha|<=2, c~U[-1,1], M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "random_polynomial", "min_order": 1, "max_order": 2, "term_count": null, "coefficient_range": [-1, 1]}},
    {"name": "random PNP 10 terms |alpha|<=4, c~U[-1,1], M=5, nu=1", "modes": 5, "input": "all_ones",
     "observable": {"type": "random_polynomial", "min_order": 1, "max_order": 4, "term_count": 10, "coefficient_range": [-1, 1]}},
    {"name": "projector collision-free |0,1,0,1,0,1>, M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "projector", "pattern": [0, 1, 0, 1, 0, 1]}},
    {"name": "projector bunched |2,1,0,0,0,0>, M=6, nu=0.5", "modes": 6, "input": "alternating",
     "observable": {"type": "projector", "pattern": [2, 1, 0, 0, 0, 0]}}
  ]
}
